using System;
using System.Collections.Generic;
using System.Globalization;

class Produto
{
    private static readonly CultureInfo CulturaBrasileira =
        new CultureInfo("pt-BR");

    private string nome = string.Empty;
    private decimal preco;
    private int estoque;

    public Produto()
    {
    }

    public Produto(string nome, decimal preco, int estoque)
    {
        Nome = nome;
        Preco = preco;
        Estoque = estoque;
    }

    public string Nome
    {
        get { return nome; }
        set
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                throw new ArgumentException(
                    "O nome do produto não pode ficar vazio.",
                    nameof(value)
                );
            }

            nome = value.Trim();
        }
    }

    public decimal Preco
    {
        get { return preco; }
        set
        {
            if (value <= 0)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(value),
                    "O preço deve ser maior que zero."
                );
            }

            preco = value;
        }
    }

    public int Estoque
    {
        get { return estoque; }
        set
        {
            if (value < 0)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(value),
                    "O estoque não pode ser negativo."
                );
            }

            estoque = value;
        }
    }

    public decimal CalcularValorTotalEstoque()
    {
        return Preco * Estoque;
    }

    public void ExibirInformacoes()
    {
        Console.WriteLine($"Produto: {Nome}");
        Console.WriteLine(
            $"Preço: {Preco.ToString("C2", CulturaBrasileira)}"
        );
        Console.WriteLine($"Estoque: {Estoque} unidades");
        Console.WriteLine(
            "Valor total em estoque: " +
            $"{CalcularValorTotalEstoque().ToString("C2", CulturaBrasileira)}"
        );
        Console.WriteLine();
    }
}

class Loja
{
    private static readonly CultureInfo CulturaBrasileira =
        new CultureInfo("pt-BR");

    private readonly List<Produto> produtos;

    public Loja()
    {
        produtos = new List<Produto>();
    }

    public void AdicionarProduto(Produto produto)
    {
        if (produto == null)
        {
            throw new ArgumentNullException(nameof(produto));
        }

        produtos.Add(produto);
    }

    public void ExibirProdutos()
    {
        Console.WriteLine("=== PRODUTOS DA LOJA ===");

        foreach (Produto produto in produtos)
        {
            produto.ExibirInformacoes();
        }
    }

    public decimal CalcularValorTotalLoja()
    {
        decimal total = 0;

        foreach (Produto produto in produtos)
        {
            total += produto.CalcularValorTotalEstoque();
        }

        return total;
    }

    public void ExibirValorTotalLoja()
    {
        Console.WriteLine(
            "Valor total do estoque da loja: " +
            $"{CalcularValorTotalLoja().ToString("C2", CulturaBrasileira)}"
        );
    }
}

class Program
{
    static void Main()
    {
        Loja loja = new Loja();

        Produto produto1 = new Produto(
            "Camiseta Básica",
            49.90m,
            100
        );

        Produto produto2 = new Produto(
            "Calça Jeans",
            129.90m,
            50
        );

        Produto produto3 = new Produto(
            "Tênis Esportivo",
            199.90m,
            30
        );

        loja.AdicionarProduto(produto1);
        loja.AdicionarProduto(produto2);
        loja.AdicionarProduto(produto3);

        loja.ExibirProdutos();
        loja.ExibirValorTotalLoja();
    }
}
