using System;

class ContaBancaria
{
    protected string numeroConta;
    protected string titular;
    protected double saldo;
    
    public ContaBancaria(string numeroConta, string titular, double saldoInicial)
    {
        this.numeroConta = numeroConta;
        this.titular = titular;
        saldo = saldoInicial;
    }
    
    public string NumeroConta
    {
        get { return numeroConta; }
        set { numeroConta = value; }
    }
    
    public string Titular
    {
        get { return titular; }
        set { titular = value; }
    }
    
    public double Saldo
    {
        get { return saldo; }
        protected set { saldo = value; }
    }
    
    public virtual void Depositar(double valor)
    {
        if (valor > 0)
        {
            saldo += valor;
            Console.WriteLine($"Depósito de R$ {valor:F2} realizado. Saldo: R$ {saldo:F2}");
        }
        else
        {
            Console.WriteLine("Valor de depósito inválido!");
        }
    }
    
    public virtual void Sacar(double valor)
    {
        if (valor > 0 && valor <= saldo)
        {
            saldo -= valor;
            Console.WriteLine($"Saque de R$ {valor:F2} realizado. Saldo: R$ {saldo:F2}");
        }
        else
        {
            Console.WriteLine("Saldo insuficiente ou valor inválido!");
        }
    }
    
    public virtual void ExibirInformacoes()
    {
        Console.WriteLine($"Conta: {numeroConta}");
        Console.WriteLine($"Titular: {titular}");
        Console.WriteLine($"Saldo: R$ {saldo:F2}");
    }
}

class ContaCorrente : ContaBancaria
{
    private double limiteChequeEspecial;
    
    public ContaCorrente(string numeroConta, string titular, double saldoInicial, double limiteChequeEspecial) 
        : base(numeroConta, titular, saldoInicial)
    {
        this.limiteChequeEspecial = limiteChequeEspecial;
    }
    
    public double LimiteChequeEspecial
    {
        get { return limiteChequeEspecial; }
        set { limiteChequeEspecial = value; }
    }
    
    public override void Sacar(double valor)
    {
        if (valor > 0 && valor <= saldo + limiteChequeEspecial)
        {
            saldo -= valor;
            Console.WriteLine($"Saque de R$ {valor:F2} realizado. Saldo: R$ {saldo:F2}");
            if (saldo < 0)
            {
                Console.WriteLine($"Usando cheque especial. Limite restante: R$ {limiteChequeEspecial + saldo:F2}");
            }
        }
        else
        {
            Console.WriteLine("Limite insuficiente ou valor inválido!");
        }
    }
    
    public override void ExibirInformacoes()
    {
        base.ExibirInformacoes();
        Console.WriteLine($"Limite Cheque Especial: R$ {limiteChequeEspecial:F2}");
    }
}

class ContaPoupanca : ContaBancaria
{
    private double taxaJuros;
    
    public ContaPoupanca(string numeroConta, string titular, double saldoInicial, double taxaJuros) 
        : base(numeroConta, titular, saldoInicial)
    {
        this.taxaJuros = taxaJuros;
    }
    
    public double TaxaJuros
    {
        get { return taxaJuros; }
        set { taxaJuros = value; }
    }
    
    public void AplicarJuros()
    {
        double juros = saldo * (taxaJuros / 100);
        saldo += juros;
        Console.WriteLine($"Juros de R$ {juros:F2} aplicados. Saldo: R$ {saldo:F2}");
    }
    
    public override void ExibirInformacoes()
    {
        base.ExibirInformacoes();
        Console.WriteLine($"Taxa de Juros: {taxaJuros}%");
    }
}

class Program
{
    static void Main()
    {
        Console.WriteLine("=== BACEN - SISTEMA BANCÁRIO ===\n");
        
        Console.WriteLine("--- Criar Conta Corrente ---");
        Console.Write("Número da conta: ");
        string numContaCorrente = Console.ReadLine();
        Console.Write("Titular: ");
        string titularCC = Console.ReadLine();
        Console.Write("Saldo inicial: R$ ");
        double saldoCC = double.Parse(Console.ReadLine());
        Console.Write("Limite cheque especial: R$ ");
        double limiteCE = double.Parse(Console.ReadLine());
        
        ContaCorrente cc = new ContaCorrente(numContaCorrente, titularCC, saldoCC, limiteCE);
        
        Console.WriteLine("\n--- Criar Conta Poupança ---");
        Console.Write("Número da conta: ");
        string numContaPoup = Console.ReadLine();
        Console.Write("Titular: ");
        string titularCP = Console.ReadLine();
        Console.Write("Saldo inicial: R$ ");
        double saldoCP = double.Parse(Console.ReadLine());
        Console.Write("Taxa de juros (%): ");
        double taxaJuros = double.Parse(Console.ReadLine());
        
        ContaPoupanca cp = new ContaPoupanca(numContaPoup, titularCP, saldoCP, taxaJuros);
        
        Console.WriteLine("\n=== INFORMAÇÕES DAS CONTAS ===");
        Console.WriteLine("\n--- Conta Corrente ---");
        cc.ExibirInformacoes();
        
        Console.WriteLine("\n--- Conta Poupança ---");
        cp.ExibirInformacoes();
        
        Console.WriteLine("\n=== REALIZANDO OPERAÇÕES ===");
        Console.WriteLine("\n--- Conta Corrente ---");
        Console.Write("Valor para depósito: R$ ");
        double deposito = double.Parse(Console.ReadLine());
        cc.Depositar(deposito);
        
        Console.Write("Valor para saque: R$ ");
        double saque = double.Parse(Console.ReadLine());
        cc.Sacar(saque);
        
        Console.WriteLine("\n--- Conta Poupança ---");
        Console.Write("Valor para depósito: R$ ");
        deposito = double.Parse(Console.ReadLine());
        cp.Depositar(deposito);
        cp.AplicarJuros();
        
        Console.WriteLine("\n=== INFORMAÇÕES FINAIS ===");
        Console.WriteLine("\n--- Conta Corrente ---");
        cc.ExibirInformacoes();
        
        Console.WriteLine("\n--- Conta Poupança ---");
        cp.ExibirInformacoes();
        
        Console.WriteLine("\nPressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}
